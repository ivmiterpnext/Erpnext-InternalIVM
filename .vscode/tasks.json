{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ruff: Check Workspace",
            "type": "shell",
            "command": "/home/lhammond/.local/bin/ruff",
            "args": ["check", ".", "--output-format=concise"],
            "problemMatcher": {
                "owner": "ruff",
                "severity": "warning",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(\\S+)\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 5
                }
            },
            "presentation": { "reveal": "silent", "panel": "shared" },
            "runOptions": { "runOn": "folderOpen" },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "ESLint: Check Workspace",
            "type": "shell",
            "command": "${workspaceFolder}/node_modules/.bin/eslint",
            "args": [".", "--format=compact"],
            "problemMatcher": "$eslint-compact",
            "presentation": { "reveal": "silent", "panel": "shared" },
            "runOptions": { "runOn": "folderOpen" },
            "group": "build"
        },
        {
            "label": "Prettier: Check Workspace",
            "type": "shell",
            "command": "${workspaceFolder}/node_modules/.bin/prettier",
            "args": ["--check", "ivm/**/*.js"],
            "problemMatcher": {
                "owner": "prettier",
                "severity": "warning",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^\\[warn\\]\\s+(.*)$",
                    "file": 1,
                    "message": 1
                }
            },
            "presentation": { "reveal": "silent", "panel": "shared" },
            "runOptions": { "runOn": "folderOpen" },
            "group": "build"
        }
    ]
}
